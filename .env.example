# Configurações do LLM Local (Ollama)
LLM_ENDPOINT_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_TIMEOUT_SECONDS=300.0

# Banco de Dados Vetorial Local (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_QUESTOES=questoes_enem

# Embeddings (intfloat/multilingual-e5-large)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu

# Banco de Dados Relacional (Padrão: SQLite local. Opcional: PostgreSQL)
DATABASE_URL=sqlite:///./questoes_ineditas.db
# Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/questoes_db
